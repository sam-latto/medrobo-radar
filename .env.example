# Required
ANTHROPIC_API_KEY=your_anthropic_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# Email (choose one transport)
EMAIL_FROM=you@example.com
EMAIL_TO=you@example.com

# Option A: SendGrid
SENDGRID_API_KEY=your_sendgrid_api_key_here

# Option B: SMTP (e.g. Gmail app password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your_app_password_here

# Optional overrides
# DB_PATH=medrobo.db
# PIPELINE_SCHEDULE_HOUR=7
# PIPELINE_SCHEDULE_MINUTE=0
# NOTABLE_FUNDING_THRESHOLD=50000000
# ANTHROPIC_MODEL=claude-sonnet-4-6
# SEARCH_TIME_RANGE=week          # Tavily recency filter: day | week | month | year
# EXTRACTION_BATCH_SIZE=15        # search results per extraction call

# Primary sources
# SEC_USER_AGENT="IndustryRadar you@example.com"   # required for SEC Form D (SEC asks for a contact email)
# OPENFDA_API_KEY=                                  # optional, raises openFDA rate limits
# NCBI_API_KEY=                                     # optional, raises PubMed rate limits
# DIGEST_MODE=combined                              # combined | per_industry
# PIPELINE_RETRY_DELAY_MINUTES=30                    # retry a failed scheduled run once, then email an alert
